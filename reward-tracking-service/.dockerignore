# T-RTS-046. Kept in lock-step with the multi-stage Dockerfile in this directory: everything a
# build stage actually needs (package.json/package-lock.json, src/, proto/, tsconfig*.json) is
# COPYed explicitly there, so nothing here needs to *allow* those paths back in — this file only
# needs to keep host-machine cruft that would otherwise bloat the build context (and, worse, get
# silently baked into an image layer if a later stage ever did a careless `COPY . .`) out.
# Mirrors `promo-code-service/.dockerignore`/`reward-redemption-service/.dockerignore` exactly.

node_modules
dist
coverage

# Local env files — never baked into an image (AGENT-PROTOCOL.md R12). Real values are injected
# at deploy time via Render's own env var mechanism (render.yaml), never a COPYed file.
.env
.env.*
!.env.example

# Git/editor/CI noise irrelevant to any build stage.
.git
.gitignore
.husky
.vscode
.idea
*.log
npm-debug.log*

# This service's own docker-compose.yml starts local-dev-only infra (Redpanda + a one-shot
# Postgres connectivity probe) that has nothing to do with the image being built from this file.
docker-compose.yml

# Test files and their own local-only test-env plumbing are never part of the shipped image —
# nothing under `runtime`/`prod-deps`/`migrator` COPYs anything from `test/`.
test

README.md

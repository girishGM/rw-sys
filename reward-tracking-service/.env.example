# reward-tracking-service — environment template.
#
# Copy to .env.development (or .env.test) for local work and fill in real values there — never
# commit that copy (repo root .gitignore already excludes .env / .env.* / !.env.example).
# src/config/config.schema.ts (T-RTS-001) is the authoritative, validated schema for this section —
# every var named here comes directly from that schema, nothing invented.

NODE_ENV=development
PORT=3040

# --- Database: the `reward_tracking` schema on the EXISTING `reward_system` Postgres 16 server
# (root CLAUDE.md — /Library/PostgreSQL/16 — do NOT point this at a second, new Postgres instance).
# Two roles, the same split the portal and every sibling service already uses:
#   DB_APP_*        least-privilege runtime role this service's own code connects as
#                    (`reward_tracking_app`, scoped to the `reward_tracking` schema only —
#                    AGENT-PROTOCOL.md R2). T-RTS-002's own migration is what actually creates
#                    this role AND sets its login password to this value — not just a placeholder
#                    the app reads at boot. Rotate here, then re-run `npm run db:migrate` once
#                    that migration exists.
#   DB_MIGRATION_*  privileged role the migration CLI (`npm run db:migrate`/`db:rollback`) uses —
#                    never imported into request-time application code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reward_system
DB_SSL=false

DB_APP_USERNAME=reward_tracking_app
DB_APP_PASSWORD=

DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=

# --- Kafka: comma-separated host:port broker list, for the inbound reward-tracking-dispatch
# consumer (T-RTS-012). `localhost:9095` matches this service's own docker-compose.yml (Redpanda) —
# deliberately not 9092/9093/9094, already used by promo-code-service's, RAP's and
# reward-redemption-service's own local Redpanda on this machine (see docker-compose.yml's header).
KAFKA_BROKERS=localhost:9095

# =================================================================================================
# Everything below this line is read directly from `process.env` by its own module, NOT validated
# by src/config/config.schema.ts (config.schema.ts is agent-rts-foundation's file scope; each var
# below is introduced by a later task owned by a different agent) — same split every sibling
# service's own `.env.example` uses. Values left empty are required with no default (boot fails
# loudly if unset/invalid, per each owning module's own contract); values pre-filled are the code's
# own documented default, shown here only for discoverability.
# =================================================================================================

# --- Portal gRPC client + cached campaign/tracker config feed (T-RTS-020,
# campaign-hierarchy.client.ts) — this service's outbound connection to the portal's own
# campaign_config.v1 gRPC service, the same feed RAP/RR already read. Only BASIC/MERCHANTS/TRACKERS
# sections are ever requested (this service has no grant to see RULES/REWARDS/CAPS).
#   PORTAL_GRPC_HOST               defaults to localhost
#   PORTAL_GRPC_PORT               defaults to 50051 (the portal's own GRPC_DEFAULT_PORT)
#   PORTAL_GRPC_TIMEOUT_MS         defaults to 5000
#   PORTAL_GRPC_WATCH_RECONNECT_MS defaults to 5000 — delay before re-opening a dropped
#                                  WatchCampaignConfig stream
#   PORTAL_GRPC_TLS_CA_PATH        mTLS client cert material. All three TLS_* vars must be set
#   PORTAL_GRPC_TLS_CERT_PATH      together, or none of them (a partial set fails boot); when none
#   PORTAL_GRPC_TLS_KEY_PATH       are set this client connects over an insecure channel.
#   PORTAL_CONFIG_TENANT_IDS       required (T-INT-005: only for CampaignCacheModule's own cold-
#                                  start warm; everything else in this service works without it),
#                                  comma-separated tenant ids to cache campaign hierarchy for, e.g.
#                                  "1,2" — left unset, campaign_hierarchy_cache simply stays empty,
#                                  logged once, never a crash (T-RTS-020's own R1 contract).
PORTAL_GRPC_HOST=localhost
PORTAL_GRPC_PORT=50051
PORTAL_GRPC_TIMEOUT_MS=5000
PORTAL_GRPC_WATCH_RECONNECT_MS=5000
PORTAL_GRPC_TLS_CA_PATH=
PORTAL_GRPC_TLS_CERT_PATH=
PORTAL_GRPC_TLS_KEY_PATH=
PORTAL_CONFIG_TENANT_IDS=

# --- Standalone entry points (T-RTS-011/012/013), each independently runnable as its own process
# (`ts-node -T -r tsconfig-paths/register src/grpc/grpc-server.main.ts`, etc.) AND, as of T-INT-005,
# optionally started in the SAME process as the primary HTTP app (`src/main.ts`) instead — each
# gated by its own flag below, read directly by `src/main.ts`. Every flag here defaults OFF (unset,
# or anything other than the literal string "true"), so leaving this whole section unset — Render's
# current REST-only deploy — behaves identically to before T-INT-005: only PORT's HTTP listener
# opens.
#   RTS_GRPC_INGEST_ENABLED   set to "true" to also start the gRPC ingest server
#                             (RewardTrackingIngestService.IngestRewardTrackingEvent) in this same
#                             process. Port: RTS_GRPC_INGEST_PORT, defaults to 50091.
#   KAFKA_CONSUMER_ENABLED    set to "true" to also start the reward.redemption.completed.v1 Kafka
#                             consumer in this same process. NOTE: this is the same env var name
#                             kafka-consumer.main.ts reads for its own standalone "off" switch
#                             (where unset means ON, by design — see that file's own header) — but
#                             src/main.ts's own hybrid-bootstrap call site (this task) requires the
#                             literal string "true" before it ever calls into that file at all, so
#                             leaving this unset means OFF in the hybrid process specifically
#                             (main.ts's own header has the full reasoning).
#   RTS_REST_INGEST_ENABLED   set to "true" to also start the standalone REST ingest HTTP server
#                             (POST /internal/reward-tracking-events) in this same process. Port:
#                             RTS_REST_INGEST_PORT, defaults to 3041 — distinct from PORT (3040)
#                             above; never both listening on the same port at once. Requires
#                             REWARD_TRACKING_INGEST_TOKEN (T-RTS-013's own guard) to be set, or
#                             this process fails to start rather than silently skipping the guard.
RTS_GRPC_INGEST_ENABLED=
RTS_GRPC_INGEST_PORT=50091
KAFKA_CONSUMER_ENABLED=
RTS_REST_INGEST_ENABLED=
RTS_REST_INGEST_PORT=3041
REWARD_TRACKING_INGEST_TOKEN=

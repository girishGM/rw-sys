# Copy to .env.development (or .env.local) and fill in real values.
# Never commit a file matching .env* other than this one — see scripts/scan-secrets.sh.

NODE_ENV=
PORT=

# RS256 keypair (02-SECURITY.md §1.1). Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# then paste each PEM's contents here with \n literal escapes, or point your secret
# manager at these keys in any non-local environment — never a file in the repo.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Database (T-002). Two distinct roles on purpose — never merge them. See
# src/database/sequelize.provider.ts and migration-connection.ts for why.
DB_HOST=
DB_PORT=
DB_NAME=
DB_SSL=

# The app's own least-privilege runtime role (reward_app in every real environment).
DB_APP_USERNAME=
DB_APP_PASSWORD=

# A privileged role, used ONLY by the migration CLI (schema creation, grants, the two
# authorised reward_config ALTERs). Never read by application runtime code.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# HTTP hardening (T-012, 02-SECURITY.md §7/§8). All five are OPTIONAL and every default is
# the restrictive one — an unset value narrows the policy, it never widens it. None is a
# secret; they are listed here because a value you cannot find documented is a value that
# gets guessed.

# This API's own public origin, e.g. https://api.example.com. Added to the CSP connect-src.
# Unset => connect-src 'self' only.
API_ORIGIN=

# Exact CORS origin allowlist, comma-separated, e.g.
#   https://portal.example.com,http://localhost:5173
# No wildcards, no trailing slashes, no paths — the app refuses to boot on any of those.
# Unset => no cross-origin request is permitted at all.
CORS_ALLOWED_ORIGINS=

# Express `trust proxy`: a hop count (1), an address/CIDR list, or `loopback`.
# `true` is REJECTED at boot — it would let any client forge its own IP via X-Forwarded-For
# and make the per-IP rate limits meaningless. Unset => trust nothing, use the socket address.
TRUST_PROXY=

# Shared rate-limit counter store. Required for any multi-instance deployment: an in-memory
# limiter across N instances is an N-times weaker limiter. Set-but-unreachable makes the auth
# routes fail closed (503) rather than silently reverting to per-process counters (AR-11).
REDIS_URL=

# How many instances of this process run. Only used to warn at boot when >1 without REDIS_URL.
APP_INSTANCE_COUNT=

# --- T-066: login rate limits in automated test environments ------------------------------
# LEAVE THIS EMPTY unless you are running the e2e suite. It multiplies the two POST /auth/login
# ceilings (normally 5 per email+IP and 20 per IP, per 15 minutes) so a full test run can drive
# more logins against one account than a human ever would. Nothing else in the §8 table moves:
# the MFA, refresh, forgot-password, global-login-ceiling and general API limits are untouched.
#
# Three things make it safe to have this knob at all:
#   * it is IGNORED when NODE_ENV=production, whatever it is set to;
#   * it is clamped (max 40), so it cannot express "no limit";
#   * anything that is not a whole number >= 2 — including empty, `abc`, `0`, `-1` — falls back
#     to the production values. It never fails open, and it never stops the boot.
# When it is in force the app logs a loud SECURITY warning at startup naming the new numbers.
LOGIN_THROTTLE_RELAX_FACTOR=

# --- T-057 (D-2/D-3): encryption key material --------------------------------------------
# `encryption_keys.key_ref` values are 'env:<NAME>' pointers (T-016, 07-DATA-PROTECTION.md
# §3) — the variable NAME lives in the database; there is deliberately no fixed variable name
# here, and no value, ever (R4). `src/database/cli/encryption-keys.ts provision <purpose>`
# prints the NAME it just registered, once, when you run it — see docs/DEPLOYMENT.md "Provision
# the first encryption keys" for the full first-run sequence. Whatever NAME it prints goes in
# this file (or your real process environment — both work, see key-material.resolver.ts) as a
# new line of its own, e.g. `FIELD_KEY=<base64 value from the CLI>`. This file intentionally
# does not declare one, because the name is data, not a fixed key of this schema.

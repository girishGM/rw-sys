{
  "name": "@reward-portal/back-end",
  "version": "0.1.0",
  "private": true,
  "description": "Reward System Portal — NestJS API",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:ui-verify": "RUN_UI_VERIFICATION=1 jest --config ./test/jest-e2e.json verify-step-2",
    "db:migrate": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts up",
    "db:rollback": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts down",
    "db:status": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts status",
    "bootstrap:superadmin": "ts-node -T -r tsconfig-paths/register src/cli/bootstrap-superadmin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/schedule": "^6.1.3",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "dotenv": "^17.4.1",
    "argon2": "^0.41.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.11.0",
    "nest-winston": "^1.9.4",
    "zod": "^3.23.8",
    "uuid": "^11.1.1",
    "cache-manager": "^5.3.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}

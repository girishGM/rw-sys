# T-052 — copy to `.env` (git-ignored — see `.gitignore`, R4) before `docker compose up`.
# This file is read two ways by `docker-compose.yml`: Compose's own `${VAR}` interpolation
# inside the compose file itself, and `env_file: .env` for the `postgres`/`migrate`/`api`
# services' process environment. Nothing here is a real secret — every value below is either a
# throwaway local/CI credential or a placeholder you replace before using this compose file for
# anything beyond your own machine or a disposable CI job.
#
# This is a DIFFERENT file from `back-end/.env.example` (for `npm run start:dev`, no Docker
# involved) — some variable names overlap on purpose (the application reads the same
# `env.schema.ts` either way), but the *values* here are container-network-appropriate
# (`DB_HOST=postgres`, not `localhost`) where `docker-compose.yml` does not already override
# that for you.

# --- Postgres (the `postgres` service's own init — see docker/postgres-init/) --------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ci_local_only
DB_NAME=reward_system

# --- The app's own least-privilege runtime role (01-DATABASE.md §3) ------------------------
# `docker/postgres-init/01-create-app-role.sh` creates this role using this exact value the
# first time the `postgres` volume is initialised — change it here before first `up` if you
# want a different one; changing it afterwards needs `docker compose down -v` (drops the
# volume) or an `ALTER ROLE` run by hand, the same as rotating any other database password.
DB_APP_USERNAME=reward_app
DB_APP_PASSWORD=ci_local_only

# --- The migration role — always the Postgres superuser above, never merged with the one
# above (T-002 note 6). Required by `env.schema.ts` even though only `migrate`'s own container
# command reads it (`db:migrate`) — `api` never connects with it.
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=ci_local_only

# --- RS256 keypair (02-SECURITY.md §1.1) — REQUIRED, no default. Generate your own:
#   openssl genrsa -out /tmp/jwt_private.pem 2048
#   openssl rsa -in /tmp/jwt_private.pem -pubout -out /tmp/jwt_public.pem
# then paste each PEM's contents on ONE line with literal `\n` in place of real newlines
# (`token.service.ts` un-escapes them at boot) — the same format `back-end/.env.example`
# documents. Left empty here deliberately: the app refuses to boot without a real keypair
# (02-SECURITY.md §9, "no silent defaults for security values"), and a placeholder that
# *looked* like a working default would be exactly the silent default that rule forbids.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Encryption key material (docs/DEPLOYMENT.md "Provision the first encryption keys") ----
# Leave both unset for the first `docker compose up`. Once the stack is healthy, run:
#   docker compose exec api node dist/database/cli/encryption-keys.js provision field
#   docker compose exec api node dist/database/cli/encryption-keys.js provision blind_index
# Each prints a `NAME=value` line ONCE — add both as new lines in this file, in the exact
# `NAME=value` form printed (the name is data, not fixed — see `back-end/.env.example`'s own
# note on why there is no fixed variable name here), then `docker compose up -d api` again so
# the new values are loaded.

# --- Ports published to the host — change if any collides with something already running.
# `METRICS_PORT` is deliberately NOT here: it is never published (TC-11) — see
# docker-compose.yml's own `api` service.
API_PORT=3000
WEB_PORT=8080

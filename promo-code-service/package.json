{
  "name": "promo-code-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone NestJS service that generates and issues promo codes for reward-redemption-service, over gRPC or Kafka depending on that caller's own reward configuration (see ../promo-code-service-plan/ARCHITECTURE.md).",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "preinstall": "node -e \"var m=process.versions.node.split('.')[0]; if(m!=='20'){console.error('\\n  \\u2717 Node 20 LTS required (found v'+process.version+'). Run: nvm install 20 && nvm use\\n');process.exit(1)}\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:status": "bash scripts/db-status.sh",
    "db:migrate": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts up",
    "db:rollback": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts down",
    "db:migrate:status": "ts-node -T -r tsconfig-paths/register src/database/cli/migrate.ts status",
    "db:seed": "ts-node -T -r tsconfig-paths/register src/database/seeds/001_seed_demo_promo_code_configs.ts",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "prepare": "cd .. && husky promo-code-service/.husky"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/microservices": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "dotenv": "^17.4.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(/src/.*\\.spec\\.ts|/test/.*\\.(e2e-)?spec\\.ts)$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/test/database/env.setup.ts",
      "<rootDir>/test/jest-e2e.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}

# promo-code-service — environment template.
#
# Copy to .env.development (or .env.test) for local work and fill in real values there —
# never commit that copy (repo root .gitignore already excludes .env / .env.* / !.env.example).
# src/config/config.schema.ts is the authoritative, validated schema; this file documents
# intent, that file enforces it. Every key below is required unless noted otherwise.

NODE_ENV=development
PORT=3010

# --- Database: the `promo_code` schema on the EXISTING `reward_system` Postgres 16 server
# (root CLAUDE.md — /Library/PostgreSQL/16 — do NOT point this at a second, new Postgres
# instance). Two roles, the same split portal/back-end already uses:
#   DB_APP_*        least-privilege runtime role this service's own code connects as
#                    (`promo_code_app`, scoped to the `promo_code` schema only —
#                    AGENT-PROTOCOL.md R1). T-PC-002's own migration
#                    (007_create_promo_code_app_role) is what actually creates this role AND
#                    sets its login password to this value — not just a placeholder the app
#                    reads at boot. Rotate here, then re-run `npm run db:migrate` (idempotent:
#                    ALTER ROLE if it already exists).
#   DB_MIGRATION_*  privileged role the migration CLI (`npm run db:migrate`/`db:rollback`)
#                    uses — never imported into request-time application code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reward_system
DB_SSL=false

DB_APP_USERNAME=promo_code_app
DB_APP_PASSWORD=

DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=

# --- Kafka: comma-separated host:port broker list. `localhost:9092` matches this service's
# own docker-compose.yml (Redpanda) — T-PC-030 wires the actual consumer/producer (Wave 3).
KAFKA_BROKERS=localhost:9092

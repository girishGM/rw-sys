# realtime-activity-processing-service — environment template.
#
# Copy to .env.development (or .env.test) for local work and fill in real values there — never
# commit that copy (repo root .gitignore already excludes .env / .env.* / !.env.example).
# src/config/config.schema.ts is the authoritative, validated schema; this file documents
# intent, that file enforces it. Every key below is required unless noted otherwise.

NODE_ENV=development
PORT=3020

# --- Database: the `realtime_activity_processing` schema on the EXISTING `reward_system`
# Postgres 16 server (root CLAUDE.md — /Library/PostgreSQL/16 — do NOT point this at a second,
# new Postgres instance). Two roles, the same split portal/back-end and promo-code-service
# already use:
#   DB_APP_*        least-privilege runtime role this service's own code connects as
#                    (`rap_app`, scoped to the `realtime_activity_processing` schema only —
#                    AGENT-PROTOCOL.md R1). T-RAP-002's own migration is what actually creates
#                    this role AND sets its login password to this value — not just a
#                    placeholder the app reads at boot. Rotate here, then re-run
#                    `npm run db:migrate` once that migration exists.
#   DB_MIGRATION_*  privileged role the migration CLI (`npm run db:migrate`/`db:rollback`)
#                    uses — never imported into request-time application code.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reward_system
DB_SSL=false

DB_APP_USERNAME=rap_app
DB_APP_PASSWORD=

DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=

# --- Kafka: comma-separated host:port broker list. `localhost:9093` matches this service's own
# docker-compose.yml (Redpanda, deliberately not 9092 — that port is already used by
# promo-code-service's own local Redpanda on this machine, see docker-compose.yml's header).
# T-RAP-023 wires the actual consumer/producer (Wave 2).
KAFKA_BROKERS=localhost:9093

# =================================================================================================
# T-RAP-057 note: everything below this line is read directly from `process.env` by its own
# module, NOT validated by src/config/config.schema.ts (each var's own source file documents why —
# in short, config.schema.ts is agent-rap-foundation's file scope, and the task that introduced
# each of these vars was owned by a different agent). This section exists purely so a fresh
# environment has one place that names every var this service reads, matching config.schema.ts's
# own set above in spirit (AGENT-PROTOCOL.md R8 — no default secret committed). Values left empty
# are required with no default (boot fails loudly if unset/invalid); values pre-filled are the
# code's own documented default, shown here only for discoverability, not because setting it below
# is required.
# =================================================================================================

# --- Field encryption (T-RAP-012, encryption.service.ts) — AES-256-GCM + HMAC-SHA-256 for
# `customerId` at rest (AGENT-PROTOCOL.md R4). Both required, both base64-encoded, must be
# different values. No default — a missing/invalid key crashes the process at module construction.
#   FIELD_ENCRYPTION_AES_KEY   decodes to exactly 32 bytes (AES-256-GCM's own fixed key size)
#   FIELD_ENCRYPTION_HMAC_KEY  decodes to at least 32 bytes, independent key material from the AES key
FIELD_ENCRYPTION_AES_KEY=
FIELD_ENCRYPTION_HMAC_KEY=

# --- T-INT-054 — REST option for SubmitActivity (src/rest/activity-ingest/), alongside the
# existing mTLS gRPC endpoint below. Built as a REST fallback (rather than provisioning a real mTLS
# CA/cert chain for test-app/tracking-service's own Render deployment) — see that task's own file,
# "Recommendation". Registered inside `AppModule` (so it can share Render's one externally-reachable
# port, unlike every other transport in this service — see activity-ingest-rest.module.ts's own
# header), but its OWN membership in that module graph is still gated, same "off unless an operator
# explicitly turns it on" convention as GRPC_SERVER_ENABLED/PROGRESS_API_ENABLED/PROCESSING_ENABLED
# below — see app.module.ts's own header for why an EARLIER unconditional-inclusion attempt was
# reverted (it broke a real, pre-existing test).
#   ACTIVITY_INGEST_REST_ENABLED  optional, defaults to "false"/unset — a plain `npm run start:dev`/
#                                  Render deploy is unaffected either way (REST/health-only, exactly
#                                  as before this task). Set to the literal string "true" to register
#                                  POST /api/v1/activities. Turning this on pulls in the SAME
#                                  prerequisites GRPC_SERVER_ENABLED=true already requires today:
#                                  FIELD_ENCRYPTION_AES_KEY/FIELD_ENCRYPTION_HMAC_KEY above, and
#                                  either a reachable portal or an already-seeded
#                                  campaign_config_snapshot row for every PORTAL_CONFIG_TENANT_IDS
#                                  tenant (CampaignConfigCacheService.bootstrap()'s own cold-start
#                                  check) — not a new category of requirement, just this leg's own
#                                  admission ticket into the same club.
#   ACTIVITY_INGEST_REST_TOKEN    required (once the flag above is "true") for this one route to
#                                  accept any request — unset, every POST /api/v1/activities call
#                                  gets 503 (the rest of this service, including /health, is
#                                  unaffected either way — see ingest-token.guard.ts's own header for
#                                  why this fails closed per request rather than at boot).
ACTIVITY_INGEST_REST_ENABLED=false
ACTIVITY_INGEST_REST_TOKEN=

# --- Customer progress API (T-RAP-040, progress-api-server.main.ts / progress-api-token.ts).
#   PROGRESS_API_PORT          optional, defaults to 3021 — only used by the STANDALONE process
#                              (`ts-node ... progress-api-server.main.ts`). Has no effect on
#                              src/main.ts's own hybrid bootstrap (see PROGRESS_API_ENABLED below):
#                              T-INT-062 corrected that path to mount the same routes on the primary
#                              HTTP listener's own PORT (3020) instead of a second port, the same
#                              "Render only exposes one port" fix T-INT-057 already made for
#                              reward-tracking-service's own REST ingest.
#   PROGRESS_API_AUTH_SECRET   required, base64-encoded, >= 32 bytes — HMAC secret for the bearer
#                              token this API's guard verifies. No default.
PROGRESS_API_PORT=3021
PROGRESS_API_AUTH_SECRET=

# --- T-INT-003 hybrid bootstrap: PROGRESS_API_ENABLED (new; the standalone progress-api-server.main.ts
# above has no enable-gate of its own to reuse) — set to the literal string "true" for src/main.ts to
# also mount the customer progress API's routes on its own primary HTTP listener (same port as
# /health — T-INT-062; the standalone process above still works unmodified and independently, on its
# own PROGRESS_API_PORT — R2). Optional, defaults to "false"/unset so a plain `npm run start:dev`/
# Render deploy behaves exactly as before this task (REST/health-only).
PROGRESS_API_ENABLED=false

# --- Inbound gRPC ingestion server (T-RAP-022, grpc-server.config.ts) — mTLS `ActivityIngestService`.
#   GRPC_SERVER_ENABLED             optional. **Two different defaults read this exact same var,
#                                    depending on which process reads it (T-INT-003)**: run
#                                    standalone (`ts-node src/grpc/grpc-server.main.ts`, or this
#                                    task's own T-RAP-022 Rollback lever), unset defaults to
#                                    ENABLED — set to "false" to disable. Run inside src/main.ts's
#                                    hybrid bootstrap instead, unset defaults to DISABLED — set to
#                                    the literal string "true" to enable there. This asymmetry is
#                                    deliberate: a hybrid process must never attempt to open a
#                                    transport an operator never configured (Render's own deploy
#                                    has no TLS material set at all) just because the standalone
#                                    file's own default says "enabled". See src/main.ts's own
#                                    header comment for the full reasoning. When disabled (either
#                                    process), none of the other GRPC_SERVER_* vars below are read.
#   GRPC_SERVER_PORT                optional, defaults to 50071
#   GRPC_SERVER_TLS_CA_PATH         required unless GRPC_SERVER_ENABLED=false — filesystem path to
#                                    the CA cert used to verify client certificates
#   GRPC_SERVER_TLS_CERT_PATH       required unless GRPC_SERVER_ENABLED=false — this server's own
#                                    TLS certificate
#   GRPC_SERVER_TLS_KEY_PATH        required unless GRPC_SERVER_ENABLED=false — this server's own
#                                    TLS private key
#   GRPC_SERVER_ALLOWED_IDENTITIES  required unless GRPC_SERVER_ENABLED=false — comma-separated
#                                    "identity:tenantId" entries, e.g.
#                                    "portal-ingest-client:1,other-client:2"
GRPC_SERVER_ENABLED=true
GRPC_SERVER_PORT=50071
GRPC_SERVER_TLS_CA_PATH=
GRPC_SERVER_TLS_CERT_PATH=
GRPC_SERVER_TLS_KEY_PATH=
GRPC_SERVER_ALLOWED_IDENTITIES=

# --- Portal gRPC client + campaign config cache (T-RAP-010, campaign-config.client.ts /
# campaign-config-cache.service.ts) — this service's outbound connection to the portal's own
# campaign_config.v1 gRPC service.
#   PORTAL_GRPC_HOST          optional, defaults to localhost
#   PORTAL_GRPC_PORT          optional, defaults to 50051 (the portal's own GRPC_DEFAULT_PORT)
#   PORTAL_GRPC_TIMEOUT_MS    optional, defaults to 5000
#   PORTAL_GRPC_TLS_CA_PATH   optional — mTLS client cert material. All three TLS_* vars must be
#   PORTAL_GRPC_TLS_CERT_PATH set together, or none of them (a partial set fails boot); when none
#   PORTAL_GRPC_TLS_KEY_PATH  are set this client connects over an insecure channel.
#   PORTAL_CONFIG_TENANT_IDS  required, comma-separated tenant ids this instance manages, e.g. "1,2"
PORTAL_GRPC_HOST=localhost
PORTAL_GRPC_PORT=50051
PORTAL_GRPC_TIMEOUT_MS=5000
PORTAL_GRPC_TLS_CA_PATH=
PORTAL_GRPC_TLS_CERT_PATH=
PORTAL_GRPC_TLS_KEY_PATH=
PORTAL_CONFIG_TENANT_IDS=

# --- T-INT-011: REST fallback transport + resolver for the same portal campaign-config client
# above (portal-config-rest.client.ts / portal-config-channel-resolver.service.ts). Table
# realtime_activity_processing.portal_config_channel_config (migration 016) resolves REST vs GRPC
# at call time, GLOBAL row defaulting to REST (Render's free tier can't run gRPC yet) —
# reward-service-integration-plan/TRANSPORT-CONFIG.md's "portal-config" leg for this service.
#   PORTAL_REST_BASE_URL                optional, defaults to http://localhost:3001/api/v1
#   PORTAL_REST_API_TOKEN               required only when the REST channel is actually attempted
#                                        (primary or fallback) — must match the portal's own
#                                        CAMPAIGN_CONFIG_API_TOKEN. No default (R1/R4 — no secret
#                                        default ships in this file).
#   PORTAL_REST_SERVICE_IDENTITY        required only when the REST channel is actually attempted
#                                        — the service_identity granted to this instance in the
#                                        portal's own grpc_service_grants table (the same table
#                                        gRPC already reads, just named via a header instead of a
#                                        certificate SAN).
#   PORTAL_REST_TIMEOUT_MS              optional, defaults to 5000
#   PORTAL_CONFIG_CHANNEL_CACHE_TTL_MS  optional, defaults to 60000 (one minute) — how long the
#                                        resolved primary/fallback channel is cached before the
#                                        next portal_config_channel_config re-read.
PORTAL_REST_BASE_URL=http://localhost:3001/api/v1
PORTAL_REST_API_TOKEN=
PORTAL_REST_SERVICE_IDENTITY=
PORTAL_REST_TIMEOUT_MS=5000
PORTAL_CONFIG_CHANNEL_CACHE_TTL_MS=60000

# --- Standalone activity.ingest.v1 Kafka consumer (T-RAP-023, ingest.config.ts /
# activity-ingest-consumer.main.ts) — its own process (`activity-ingest-consumer.main.ts`), which
# still works completely unmodified (R2); T-INT-003's hybrid bootstrap (src/main.ts) can also start
# this same consumer inside its own process instead/as well.
#   ACTIVITY_INGEST_CONSUMER_ENABLED  optional. **Same two-different-defaults-per-process caveat as
#                                     GRPC_SERVER_ENABLED above (T-INT-003)**: run standalone, unset
#                                     defaults to ENABLED (set to "false" to disable — this task's
#                                     own Rollback lever). Run inside src/main.ts's hybrid
#                                     bootstrap, unset defaults to DISABLED (set to the literal
#                                     string "true" to enable there) — see src/main.ts's own header
#                                     comment.
ACTIVITY_INGEST_CONSUMER_ENABLED=true

# --- T-INT-043 hybrid bootstrap: the processing/dispatch worker bundle (ProcessingModule +
# DispatchModule — ActivityLogClaimWorker -> RuleEvaluatorService/TrackerCompletionEvaluatorService
# -> CapEnforcementService -> reward_entry creation -> OutboxPublisherService/
# RewardDispatchRetryWorker dispatch to reward-redemption-service). Unlike GRPC_SERVER_ENABLED/
# ACTIVITY_INGEST_CONSUMER_ENABLED above, this bundle never had a standalone *.main.ts of its own to
# borrow a default from — PROCESSING_ENABLED is the ONLY gate, and it defaults to DISABLED (unset),
# same as PROGRESS_API_ENABLED above, so a plain `npm run start:dev`/Render deploy is unaffected.
#   PROCESSING_ENABLED  optional, defaults to "false"/unset. Set to the literal string "true" to
#                        start the worker bundle inside src/main.ts's own hybrid process. Requires
#                        DB_APP_*/FIELD_ENCRYPTION_*/PORTAL_GRPC_*/PORTAL_CONFIG_TENANT_IDS (already
#                        required elsewhere) PLUS, once enabled, REWARD_REDEMPTION_REST_TOKEN below
#                        — DispatchModule's RewardRestFallbackClient factory reads it eagerly at DI
#                        construction time regardless of which dispatch channel actually ends up
#                        selected for a given tenant/campaign (reward-dispatch-channel-resolver.
#                        service.ts), so it is required to enable this gate at all, not only "when
#                        the REST channel is actually selected" as REWARD_REDEMPTION_REST_TOKEN's
#                        own note below still correctly says for every OTHER caller of that client.
PROCESSING_ENABLED=false

# --- Reward-redemption-service gRPC fallback client (T-RAP-034, reward-grpc-fallback.client.ts) —
# tier-2 dispatch fallback (05-PROCESSING-PIPELINE.md §7). Deliberately a distinct var prefix from
# PORTAL_GRPC_* above — a different remote service, must never inherit the portal's own host/port/
# TLS material.
#   REWARD_REDEMPTION_GRPC_HOST          optional, defaults to localhost
#   REWARD_REDEMPTION_GRPC_PORT          optional, defaults to 50081 (T-INT-006 port fix — RR's own
#                                         real gRPC server default; this used to wrongly default
#                                         50061, reward-service-integration-plan/ARCHITECTURE.md
#                                         finding 6(c))
#   REWARD_REDEMPTION_GRPC_TIMEOUT_MS    optional, defaults to 5000
#   REWARD_REDEMPTION_GRPC_TLS_CA_PATH   optional — same all-three-or-none TLS rule as
#   REWARD_REDEMPTION_GRPC_TLS_CERT_PATH PORTAL_GRPC_TLS_* above.
#   REWARD_REDEMPTION_GRPC_TLS_KEY_PATH
REWARD_REDEMPTION_GRPC_HOST=localhost
REWARD_REDEMPTION_GRPC_PORT=50081
REWARD_REDEMPTION_GRPC_TIMEOUT_MS=5000
REWARD_REDEMPTION_GRPC_TLS_CA_PATH=
REWARD_REDEMPTION_GRPC_TLS_CERT_PATH=
REWARD_REDEMPTION_GRPC_TLS_KEY_PATH=

# --- Reward-redemption-service REST fallback client (T-INT-006, reward-rest-fallback.client.ts) —
# the new REST dispatch option for this leg (rap-to-rr), alongside the two above. Posts to RR's real
# POST /api/v1/reward-entries (reward-redemption-service/src/rest/reward-entries/
# reward-entries.controller.ts). REWARD_REDEMPTION_REST_TOKEN must match RR's own
# REWARD_ENTRY_INGEST_TOKEN value (operational provisioning, not a default this codebase ships).
#   REWARD_REDEMPTION_REST_BASE_URL      optional, defaults to http://localhost:3030
#   REWARD_REDEMPTION_REST_TOKEN         required when the REST channel is actually selected
#   REWARD_REDEMPTION_REST_TIMEOUT_MS    optional, defaults to 5000
REWARD_REDEMPTION_REST_BASE_URL=http://localhost:3030
REWARD_REDEMPTION_REST_TOKEN=
REWARD_REDEMPTION_REST_TIMEOUT_MS=5000

# --- rap-to-rr dispatch-channel-config cache TTL (T-INT-006, reward-dispatch-channel-resolver.service.ts)
#   REWARD_DISPATCH_CHANNEL_CACHE_TTL_MS  optional, defaults to 60000
REWARD_DISPATCH_CHANNEL_CACHE_TTL_MS=60000

# --- Seed data (T-RAP-003, seed-data.constants.ts) — overrides the demo tenant id used by
# `npm run db:seed` when the portal's own demo tenant isn't id 1 in this environment.
#   DEMO_PORTAL_TENANT_ID   optional, defaults to 1
DEMO_PORTAL_TENANT_ID=1

# Rendered to /etc/nginx/conf.d/default.conf at container start by the base `nginx:1.27-alpine`
# image's own built-in entrypoint (any file under /etc/nginx/templates/*.template is envsubst'd
# automatically — no custom entrypoint script needed, unlike portal/front-end's Dockerfile.render,
# which predates relying on that feature). Only ${TRACKING_SERVICE_UPSTREAM_HOST} is substituted;
# every other `$variable` below is nginx's own and is left alone, since the base image's
# entrypoint restricts envsubst to names that are actually set in the container's environment.

server {
  listen 8080;
  server_name _;

  location = /nginx-health {
    default_type text/plain;
    return 200 'ok';
  }

  # Every real API call (REST + the SSE stream at /api/events) proxies to tracking-service —
  # same-origin from the browser's point of view, so tracking-service's own CORS restriction
  # (test-app/tracking-service/src/app.ts, scoped to the dev origin) never comes into play here.
  location /api/ {
    proxy_pass http://${TRACKING_SERVICE_UPSTREAM_HOST}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE (GET /api/events) needs an unbuffered, effectively unbounded-read connection — nginx's
    # normal proxy buffering holds the response until it's "complete," which an SSE stream never
    # is. Without these, /api/events looks connected but the frontend never receives an event
    # until the connection is eventually torn down.
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection '';
    chunked_transfer_encoding off;
    proxy_read_timeout 24h;
  }

  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback — React Router owns every other path client-side.
  location / {
    try_files $uri $uri/ /index.html;
  }
}

# Copy to .env and fill in real values. Never commit .env itself (see ../.gitignore).

# Port this service listens on.
PORT=4001

# --- Portal integration (added by T-003) ---------------------------------------------------
# Base URL of portal/back-end's REST API this service logs into to pull real campaign/tracker
# config, e.g. http://localhost:3001 (see reward-system/CLAUDE.md's port-mismatch note — the
# back-end's own PORT default of 3000 does not match the front-end proxy's 3001).
PORTAL_BASE_URL=

# Seeded portal account this service authenticates as (POST /api/v1/auth/login). Deliberately
# tenant_admin, not merchant — see the T-003 completion report's "Deviations from spec": a
# merchant-role session is denied (scope-strategy.ts's own `deny()` on `Tracker`/
# `TrackerComponent`) from ever reading GET /campaigns/:id/journey's tracker/component structure,
# no matter what data exists, so it cannot satisfy this client's actual job. tenant_admin has
# tenant-scoped *read* access to that structure and, unlike maker/checker, cannot write anything
# (no create/update/submit permission on the campaign entity) — least privilege for a read-only
# client. Never commit the real value below; only the variable name belongs in this file.
PORTAL_LOGIN_EMAIL=
PORTAL_LOGIN_PASSWORD=

# Optional. Milliseconds a fetched campaign/journey is cached before portal-client refetches it.
# Defaults to 300000 (5 minutes) if unset — see portal-client/client.ts's DEFAULT_CACHE_TTL_MS.
PORTAL_CACHE_TTL_MS=

# --- promo-code-service integration (real code generation for `promo_code` rewards) --------
# Both optional together: unset either one and this service falls back to an invented `SAVE##`
# code for every promo_code reward, exactly as before this integration existed — see
# promo-code-client/from-env.ts and engine/reward.ts's fallback path. Base URL of
# promo-code-service's own REST API, e.g. http://localhost:3010.
PROMO_CODE_SERVICE_BASE_URL=

# The `GENERATION_SERVICE_TOKEN` bearer secret promo-code-service's own `.env` defines for
# `POST /api/v1/promo-codes/generate` — a DISTINCT secret from whatever token the portal itself
# holds for that service's config/bind endpoints (promo-code-service/CLAUDE.md: "only a real
# generation caller should ever hold this one — never give it to the portal"). Never commit the
# real value below; only the variable name belongs in this file.
PROMO_CODE_SERVICE_GENERATION_TOKEN=

# --- realtime-activity-processing-service ("RAP") integration (best-effort forward of every -----
# submitted activity to RAP's real SubmitActivity gRPC endpoint, additive to this app's own
# in-memory engine — see rap-client/client.ts) --------------------------------------------------
# Unlike the two integrations above, this one is ON BY DEFAULT — every var below is optional and
# defaults to RAP's own local-dev defaults (realtime-activity-processing-service/.env.example).
# Safe to leave everything unset: RAP's own gRPC server is not started anywhere by default, even
# locally (see that service's own CLAUDE.md "Standalone entry points" section), so out of the box
# every submitted activity will just log one caught, harmless "unreachable" warning — this app's
# own behaviour and response shape are completely unaffected either way.

# Set to "false" to disable this integration entirely (no attempted calls, no log lines).
RAP_GRPC_ENABLED=

# Defaults to localhost:50071 — RAP's own GRPC_SERVER_PORT default.
RAP_GRPC_HOST=
RAP_GRPC_PORT=

# Optional. Milliseconds before a SubmitActivity call is abandoned as unreachable. Defaults to
# 2500 if unset.
RAP_GRPC_TIMEOUT_MS=

# Optional mTLS client-certificate material — RAP's real gRPC server refuses any connection
# without a CA-signed client certificate at the TLS handshake itself (mtls.guard.ts), so these are
# only useful if you've actually started RAP's gRPC server locally with matching CA/allowlist
# material. All three must be set together, or none of them; left unset, this client connects
# over an insecure channel, which simply fails (caught and logged) against a real mTLS-enabled RAP.
RAP_GRPC_TLS_CA_PATH=
RAP_GRPC_TLS_CERT_PATH=
RAP_GRPC_TLS_KEY_PATH=

# --- T-INT-022 — reward-tracking-service ("RTS") integration: this customer's *confirmed* reward
# summary (leg 7, GET /api/rewards/confirmed), sourced from RTS's real
# `GET /customers/:customerId/rewards/summary`. Unlike RAP above, this one genuinely cannot have a
# safe built-in default for its secret (see reward-tracking-client/from-env.ts's own header) —
# unset CUSTOMER_API_AUTH_SECRET and this integration degrades to `status: 'not_configured'`,
# never a crash, exactly like PROMO_CODE_SERVICE_* above.

# Base URL of reward-tracking-service's own REST API. Defaults to http://localhost:3040 (RTS's own
# PORT default) when unset.
REWARD_TRACKING_SERVICE_BASE_URL=

# The exact same base64-encoded HMAC secret reward-tracking-service's own CUSTOMER_API_AUTH_SECRET
# is configured with (reward-tracking-service/src/modules/auth/customer-auth.guard.ts) — this app
# mints the customer bearer token that guard verifies (see reward-tracking-client/token.ts's own
# header for why minting, not just holding a static token, is this app's job here). Never commit
# the real value below; only the variable name belongs in this file.
CUSTOMER_API_AUTH_SECRET=

# Optional. Milliseconds before a rewards/summary call is abandoned as unreachable. Defaults to
# 3000 if unset.
REWARD_TRACKING_SERVICE_TIMEOUT_MS=

# REST (default) or GRPC. GRPC is accepted by set-transport-primary.js (--service=test-app-tracking-
# service --leg=rts-rewards) but has nothing to actually call yet — reward-tracking-service exposes
# no read-facing gRPC surface today (ingest-only); selecting GRPC here fails closed with a clear
# error on the next request rather than hanging. See T-INT-022's completion report.
REWARD_TRACKING_TRANSPORT_PRIMARY=

# --- T-INT-021 — realtime-activity-processing-service ("RAP") CUSTOMER PROGRESS API (leg 2/finding
# 4): this customer's real tracker/component completion state, sourced from RAP's own materialized
# progress (`GET /api/dashboard`'s `trackerProgress[].completedCount`/`.completed`), replacing the
# invented `ProgressStore` flags that field used to carry. Unlike RTS's confirmed-rewards leg above,
# this is a READ PATH A REAL PAGE DEPENDS ON TO RENDER (the Dashboard's "Your Progress" widget) —
# closer to RAP_GRPC_* above's "best effort, never crash the caller" contract than to a purely
# optional integration, so every var below except the secret defaults ON. Unset
# PROGRESS_API_AUTH_SECRET and every tracker's progress reports `progressUnknown: true` rather than
# a crash or an invented zero — see `rap-progress-client/from-env.ts`'s own header.

# The exact same base64-encoded HMAC secret RAP's own PROGRESS_API_AUTH_SECRET is configured with
# (realtime-activity-processing-service/src/modules/progress-api/progress-api-token.ts) — this app
# mints the bearer token that verifies against, same "we are the upstream gateway" reasoning
# `reward-tracking-client/token.ts`/`rap-progress-client/token.ts` already establish for the
# identical problem. Never commit the real value below; only the variable name belongs in this file.
PROGRESS_API_AUTH_SECRET=

# Base URL of RAP's own progress-api REST surface (T-RAP-040's `ProgressController`, its own
# standalone `progress-api-server.main.ts`/hybrid-bootstrap process). Defaults to
# http://localhost:3021 (RAP's own PROGRESS_API_PORT default) when unset.
RAP_PROGRESS_REST_BASE_URL=

# Optional. Milliseconds before a REST progress call is abandoned as unreachable. Defaults to 3000
# if unset.
RAP_PROGRESS_REST_TIMEOUT_MS=

# RAP's real gRPC equivalent (T-INT-020's `ProgressQueryService`), registered on the SAME gRPC
# server/port as `ActivityIngestService` above (RAP_GRPC_HOST/PORT) — defaults to
# localhost:50071 (RAP's own GRPC_SERVER_PORT default) when unset.
RAP_PROGRESS_GRPC_HOST=
RAP_PROGRESS_GRPC_PORT=

# Optional. Milliseconds before a gRPC progress call is abandoned as unreachable. Defaults to 3000
# if unset.
RAP_PROGRESS_GRPC_TIMEOUT_MS=

# Optional mTLS client-certificate material for the gRPC transport above — RAP's real gRPC server
# refuses any connection without a CA-signed client certificate at the TLS handshake itself,
# regardless of which service on that listener is being called (see rap-progress-client/grpc.client.ts's
# own header). All three must be set together, or none of them; a partial/invalid set disables only
# this leg's GRPC transport (REST stays usable) rather than the whole integration.
RAP_PROGRESS_GRPC_TLS_CA_PATH=
RAP_PROGRESS_GRPC_TLS_CERT_PATH=
RAP_PROGRESS_GRPC_TLS_KEY_PATH=

# REST (default) or GRPC — this plan's own R1 default (reward-service-integration-plan/AGENT-PROTOCOL.md).
# Switchable with zero code change via `node reward-service-integration-plan/scripts/
# set-transport-primary.js --service=test-app-tracking-service --leg=rap-progress --primary=...`
# (rewrites this one line; this app reads it once at process start — restart to pick up a change).
RAP_PROGRESS_TRANSPORT_PRIMARY=
